{
    "name": "tekkan-servis",
    "version": "2.0.0",
    "description": "Tekkan Robot Servis Yönetim Uygulaması",
    "scripts": {
        "start": "npx serve www -p 3000",
        "cap:init": "npx cap init TekkanServis com.tekkan.servis --web-dir www",
        "cap:add:android": "npx cap add android",
        "cap:add:ios": "npx cap add ios",
        "cap:sync": "npx cap sync",
        "cap:open:android": "npx cap open android",
        "cap:open:ios": "npx cap open ios",
        "build:android": "npx cap sync android && npx cap open android"
    },
    "dependencies": {
        "@capacitor/android": "^6.2.0",
        "@capacitor/core": "^6.2.0",
        "@capacitor/ios": "^6.2.0"
    },
    "devDependencies": {
        "@capacitor/cli": "^6.2.0",
        "serve": "^14.2.4"
    }
}
